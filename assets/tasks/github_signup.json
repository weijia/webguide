  "steps": [
    {
      "id": "step_1",
      "order": 1,
      "title": "访问 GitHub 注册页面",
      "description": "首先，我们需要打开 GitHub 的注册页面。页面会显示一个欢迎界面，要求你输入邮箱地址来开始注册流程。",
      "target": {
        "selector": "input[type='email']",
        "tag": "input",
        "text": "Email",
        "attributes": {
          "type": "email"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "click",
      "validation": "elementAppeared",
      "hint": "如果页面没有自动跳转，请手动访问 github.com/signup",
      "waitAfterComplete": 2000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_2",
      "order": 2,
      "title": "输入你的邮箱地址",
      "description": "在邮箱输入框中输入你想用来注册 GitHub 的邮箱地址。建议使用常用邮箱，因为后续需要验证。",
      "target": {
        "selector": "input[type='email']",
        "tag": "input",
        "text": "Email",
        "attributes": {
          "type": "email"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "input",
      "validation": "urlChange",
      "hint": "请确保输入有效的邮箱地址，例如 yourname@example.com",
      "waitAfterComplete": 3000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_3",
      "order": 3,
      "title": "输入密码",
      "description": "为你的 GitHub 账号设置一个安全的密码。密码至少需要 15 个字符，或者至少 8 个字符并包含数字和字母。",
      "target": {
        "selector": "input[type='password']",
        "tag": "input",
        "text": "Password",
        "attributes": {
          "type": "password"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "input",
      "validation": "elementAppeared",
      "hint": "建议使用包含大小写字母、数字和特殊字符的强密码",
      "waitAfterComplete": 2000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_4",
      "order": 4,
      "title": "确认密码",
      "description": "再次输入你刚才设置的密码，以确保两次输入一致。系统会检查两次密码是否匹配。",
      "target": {
        "selector": "input[type='password']",
        "tag": "input",
        "text": "Password",
        "attributes": {
          "type": "password"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "input",
      "validation": "elementAppeared",
      "hint": "请确保与上一步输入的密码完全一致",
      "waitAfterComplete": 2000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_5",
      "order": 5,
      "title": "输入用户名",
      "description": "选择一个唯一的 GitHub 用户名。用户名将作为你的个人主页地址（github.com/username），一旦设置后可以修改但建议慎重选择。",
      "target": {
        "selector": "input[type='text']",
        "tag": "input",
        "text": "Username",
        "attributes": {
          "type": "text"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "input",
      "validation": "elementAppeared",
      "hint": "用户名只能包含字母、数字和连字符，且不能以连字符开头或结尾",
      "waitAfterComplete": 2000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_6",
      "order": 6,
      "title": "验证邮箱",
      "description": "GitHub 会向你注册的邮箱发送一封验证邮件。请检查你的收件箱（包括垃圾邮件文件夹），找到来自 GitHub 的验证邮件并点击验证链接。",
      "target": {
        "selector": "input[type='text']",
        "tag": "input",
        "text": "Verify",
        "attributes": {
          "type": "text"
        },
        "waitForElement": true,
        "waitTimeout": 120000
      },
      "action": "input",
      "validation": "manual",
      "hint": "验证码通常会在几秒内发送到你的邮箱，如果没有收到请检查垃圾邮件",
      "waitAfterComplete": 3000,
      "isOptional": false,
      "timeout": 180000
    },
    {
      "id": "step_7",
      "order": 7,
      "title": "完成验证并继续",
      "description": "输入邮箱中收到的验证码，点击验证按钮完成邮箱验证。验证成功后，你将被引导到下一步。",
      "target": {
        "selector": "button[type='submit']",
        "tag": "button",
        "text": "Verify",
        "attributes": {
          "type": "submit"
        },
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "click",
      "validation": "urlChange",
      "hint": "如果验证码过期，可以点击重新发送按钮获取新的验证码",
      "waitAfterComplete": 3000,
      "isOptional": false,
      "timeout": 60000
    },
    {
      "id": "step_8",
      "order": 8,
      "title": "进入 Dashboard",
      "description": "恭喜！注册和验证都已完成。现在你将进入 GitHub 的 Dashboard 页面，你可以在这里开始探索 GitHub 的功能，创建仓库，或者完善你的个人资料。",
      "target": {
        "selector": "h2",
        "tag": "h2",
        "text": "Home",
        "waitForElement": true,
        "waitTimeout": 30000
      },
      "action": "wait",
      "validation": "elementAppeared",
      "hint": "你可以点击左侧菜单浏览不同的功能区域",
      "waitAfterComplete": 2000,
      "isOptional": false,
      "timeout": 60000
    }
  ]
